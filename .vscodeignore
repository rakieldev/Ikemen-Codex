# Everything listed here is left out of the .vsix.
# Kept on purpose: src/, syntaxes/, languages/, data/sctrls.json, data/triggers.json,
# package.json, README.md, CHANGELOG.md and LICENCE.
.vscode/**
.vscode-test/**
.github/**
.gitignore
.gitattributes
vsc-extension-quickstart.md
**/*.vsix
**/*.map

# Development files; the parser and overrides below are also used at runtime.
CONTRIBUTING.md
tools/**
!tools/docparser.js
!tools/overrides.json
test/**
data/source/**
language-configuration.json

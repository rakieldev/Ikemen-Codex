{
	"name": "CNS",
	"scopeName": "source.cns",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#sections"
		},
		{
			"include": "#triggerkeys"
		},
		{
			"include": "#typekey"
		},
		{
			"include": "#keyvalue"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#functions"
		}
	],
	"repository": {
		"sections": {
			"name": "entity.name.section",
			"begin": "^\\s*\\[",
			"end": "\\]|$",
			"patterns": [
				{
					"include": "#numbers"
				}
			]
		},
		"triggerkeys": {
			"match": "(?i)^\\s*(trigger(?:all|[0-9]+))\\s*(=)\\s*",
			"captures": {
				"1": {
					"name": "keyword.control.trigger.cns"
				},
				"2": {
					"name": "keyword.operator.assignment.cns punctuation.separator.mapping.key-value.cns"
				}
			}
		},
		"typekey": {
			"match": "(?i)^\\s*(type)\\s*(=)\\s*([A-Za-z_]\\w*)?",
			"captures": {
				"1": {
					"name": "storage.type.cns"
				},
				"2": {
					"name": "keyword.operator.assignment.cns punctuation.separator.mapping.key-value.cns"
				},
				"3": {
					"name": "support.class.sctrl.cns"
				}
			}
		},
		"keyvalue": {
			"match": "^\\s*([a-zA-Z-._][a-zA-Z0-9-._]*)\\s*(=)\\s*",
			"captures": {
				"1": {
					"name": "keyword.other meta.mapping.key.cns"
				},
				"2": {
					"name": "keyword.operator.assignment.cns punctuation.separator.mapping.key-value.cns"
				}
			}
		},
		"comments": {
			"name": "comment.line.cns",
			"begin": ";",
			"end": "$\\n?"
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.cns",
					"match": "[0-9]*\\.[0-9]+"
				},
				{
					"name": "constant.numeric.cns",
					"match": "[0-9]+"
				},
				{
					"name": "constant.numeric.cns",
					"match": "[a-zA-Z]{1,2}[0-9]+\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "(?i)(const|const240p|const480p|const720p|stagevar|stageconst|gethitvar|animframe|clsnoverlap|clsnvar|explodvar|fightscreenvar|hitdefvar|inputtime|map|projvar|gamevar|isasserted|drawpal)\\s*\\(([^)]*)\\)",
					"captures": {
						"1": {
							"name": "support.function.cns"
						},
						"2": {
							"name": "string.unquoted.cns"
						}
					}
				},
				{
					"match": "([a-zA-Z-._][a-zA-Z0-9-._]*)\\s*(\\()",
					"captures": {
						"1": {
							"name": "support.function.cns"
						}
					}
				},
				{
					"match": "([a-zA-Z-._][a-zA-Z0-9-._]*)\\s+([a-zA-Z])",
					"captures": {
						"1": {
							"name": "support.function.cns"
						}
					}
				},
				{
					"match": "([a-zA-Z-._][a-zA-Z0-9-._]*)",
					"captures": {
						"1": {
							"name": "support.function.cns"
						}
					}
				}
			]
		},
		"operators": {
			"name": "keyword.operator.cns",
			"match": "(!|~|-|\\*\\*|\\*|/|%|\\+|>|>=|<|<=|=|!=|:=|&|\\^|\\||&&|\\^\\^|\\|\\|)"
		},
		"strings": {
			"name": "string.quoted.double.cns",
			"begin": "\"",
			"end": "\"|$"
		}
	}
}
